# Backend-only variable names for Google Safe Browsing (hashes.search). No values here.
# The application does NOT load .env files automatically. Set these as backend environment
# variables in your shell only (e.g. `read -rs GOOGLE_SAFE_BROWSING_API_KEY && export GOOGLE_SAFE_BROWSING_API_KEY`).
# Never put the key in frontend/.env, a VITE_ variable, chat, code, logs, docs or commits.
#
# External lookups stay OFF unless BOTH the key and the exact mode value below are set.
# Non-commercial capstone use only (commercial use requires Web Risk). See docs/SAFE_BROWSING.md.
GOOGLE_SAFE_BROWSING_API_KEY=
# Exactly "live-noncommercial" turns lookups on. Any other value keeps them off (policy_pending).
PTOS_SAFE_BROWSING_MODE=
# Optional per-URL lookup deadline in seconds (default 1, development proposal). Must be < 5.
PTOS_SAFE_BROWSING_TIMEOUT_SECONDS=

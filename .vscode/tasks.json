{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PtoS: 앱 실행",
      "dependsOn": ["PtoS: 백엔드", "PtoS: 프론트엔드"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "PtoS: 백엔드",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000", "--no-access-log"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ptos-backend",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started (server|reloader) process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "ptos" }
    },
    {
      "label": "PtoS: 프론트엔드",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ptos-frontend",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "ptos" }
    }
  ]
}

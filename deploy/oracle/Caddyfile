# PtoS 발표 시연용 Caddy 설정 (docs/DEPLOY_ORACLE.md)
# PTOS_DOMAIN은 /etc/caddy/caddy.env 또는 systemd 환경에서 준다. 예: 140-238-1-2.sslip.io
# Caddy가 Let's Encrypt 인증서를 자동으로 받고 http를 https로 돌린다.
# access log(log 지시어)를 켜지 않는다. 요청 주소·본문을 파일에 남기지 않는다.

{$PTOS_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /opt/ptos/frontend/dist
		try_files {path} /index.html
		file_server
	}

	# 서비스 워커와 화면 진입 파일은 항상 새로 받게 한다(배포 후 옛 화면이 남지 않게).
	@fresh path /sw.js /index.html / /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	# CSP는 frontend/vite.config.ts의 PTOS_CSP와 같게 유지한다(바깥 스크립트·글꼴·연결 없음, 스크린샷 미리보기는 blob:).
	# HSTS는 sslip.io 같은 빌린 주소에서도 문제없게 하루만 두고 하위 도메인에 넓히지 않는다.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=86400"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

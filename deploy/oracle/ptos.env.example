# /etc/ptos/ptos.env 예시 (서버에만 둔다. 실제 값을 이 파일이나 저장소에 쓰지 않는다)
# sudo install -m 600 -o root -g root ptos.env.example /etc/ptos/ptos.env 후 값만 채운다.

# OCR (setup_server.sh가 Tesseract와 언어 데이터를 준비한다)
TESSERACT_CMD=/usr/bin/tesseract

# 가족 보호(발표 시연 한정). 저장소 밖 경로만 허용한다.
PTOS_FAMILY_DB_PATH=/var/lib/ptos/family.db
# 확인 요청·의견 보관 기간(일, 1~30). 임시값 7.
PTOS_FAMILY_RETENTION_DAYS=7

# 웹 푸시. 세 값과 모드가 모두 있어야 켜진다. 키는 generate_vapid_keys.py로 만든다.
PTOS_PUSH_MODE=live-webpush
PTOS_VAPID_PUBLIC_KEY=
PTOS_VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제를 알릴 연락처. 팀 공용 메일을 권한다. 예: mailto:team@example.com
PTOS_VAPID_SUBJECT=

# 경량 모델(선택). 모델 폴더를 서버에 복사한 경우에만 채운다.
# PTOS_MODEL_PATH=/opt/ptos-model/manifest.json

# URL 평판 조회(선택). 켜는 것은 사용자가 직접 한다. 비워 두면 꺼짐.
# GOOGLE_SAFE_BROWSING_API_KEY=
# PTOS_SAFE_BROWSING_MODE=live-noncommercial
